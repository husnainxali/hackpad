{
    "manufacturer": "Brokie",
    "keyboard_name": "brokiepad",
    "maintainer": "Brokie",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgblight": true,
        "oled": true
    },
    "rgblight": {
        "driver": "ws2812",
        "led_count": 9
    },
    "ws2812": {
        "driver": "vendor",
        "pin": "GP27"
    },
    "matrix_pins": {
        "cols": ["GP28", "GP29", "GP2"],
        "rows": ["GP4", "GP0", "GP1"]
    },
    "processor": "RP2040",
    "url": "https://github.com/husnainxali/hackpad",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "i2c": {
        "driver": "vendor",
        "sda_pin": "GP6",
        "scl_pin": "GP7"
        },
    "layouts": {
        "LAYOUT_ortho_3x3": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2}
            ]
        }
    }
}
